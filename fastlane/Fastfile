# Lanes used by .github/workflows/apple-builds.yml (not needed for local builds).
#
# Environment: FIREBASE_PROJECT_NUMBER, FIREBASE_IOS_APP_ID, FIREBASE_SERVICE_ACCOUNT_JSON,
# NOTARY_API_KEY_ID, NOTARY_API_ISSUER_ID, NOTARY_API_KEY_P8 (the .p8 text), BUNDLE_ID, APPLE_TEAM_ID.

default_platform(:ios)

platform :ios do
  def asc_key
    app_store_connect_api_key(
      key_id: ENV.fetch("NOTARY_API_KEY_ID"),
      issuer_id: ENV.fetch("NOTARY_API_ISSUER_ID"),
      key_content: ENV.fetch("NOTARY_API_KEY_P8"),
      is_key_content_base64: false,
      duration: 1200
    )
  end

  # Firebase App Distribution testers' UDIDs -> devices registered with Apple. Devices already
  # registered are left as they are, so this is safe to run every time.
  lane :sync_devices do
    file = File.join(ENV.fetch("RUNNER_TEMP", Dir.tmpdir), "tester_udids.txt")
    firebase_app_distribution_get_udids(
      project_number: ENV.fetch("FIREBASE_PROJECT_NUMBER").to_i,
      service_credentials_json_data: ENV.fetch("FIREBASE_SERVICE_ACCOUNT_JSON"),
      output_file: file
    )
    if File.exist?(file)
      UI.message(File.read(file))
      register_devices(devices_file: file, api_key: asc_key)
    end
  end

  # A fresh ad-hoc distribution profile for the app, covering every device registered with
  # Apple (Xcode's automatic export signing can't make one with only an API key: it asks for
  # cloud signing, which the key may not use). visionOS apps use the iOS profile types.
  # Prints the profile's name to $GITHUB_ENV as ADHOC_PROFILE_NAME.
  lane :adhoc_profile do
    dir = File.expand_path("~/Library/Developer/Xcode/UserData/Provisioning Profiles")
    FileUtils.mkdir_p(dir)
    get_provisioning_profile(
      api_key: asc_key,
      app_identifier: ENV.fetch("BUNDLE_ID"),
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      adhoc: true,
      force: true, # picks up devices registered since the last build
      platform: "ios",
      output_path: dir,
      filename: "adhoc.mobileprovision"
    )
    name = lane_context[SharedValues::SIGH_NAME]
    UI.message("Ad-hoc profile: #{name}")
    File.write(ENV["GITHUB_ENV"], "ADHOC_PROFILE_NAME=#{name}\n", mode: "a") if ENV["GITHUB_ENV"]
  end

  # Upload an .ipa to Firebase App Distribution and invite the given groups (comma-separated,
  # may be empty: the release is then only listed in the Firebase console).
  lane :distribute do |options|
    groups = options[:groups].to_s.strip
    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_IOS_APP_ID"),
      service_credentials_json_data: ENV.fetch("FIREBASE_SERVICE_ACCOUNT_JSON"),
      ipa_path: options.fetch(:ipa),
      groups: groups.empty? ? nil : groups,
      release_notes: options[:notes]
    )
  end
end
